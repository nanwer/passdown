LOCAL_ACCESS.md
.next-*

# Regenerated by Next on every dev run and build, importing from whichever
# build directory that run used, so its content tracks the last command run
# rather than the source. The stable half lives in apps/web/next-types.d.ts.
apps/web/next-env.d.ts

# Local example publisher identity map (never credentials)
.local-formatting-examples.json

# Local working notes, credentials and generated evidence are never public source.
.private/
apps/web/*.md
docs/development/published-formatting-examples.md
*.dump
*.bundle
*.bak

# Uploaded images. Local content, never committed.
.media/

# Disposable uploads from browser test runs.
.media-authoring/

# Correspondence and verification notes written during development. These are
# working documents, not project source, and some quote local evidence.
/claude-*.md
/review-for-gpt-*.md
/feedback-to-gpt-*.md

# Generated operator command bundle
apps/operator/dist/

# Do not copy this by hand; run init.sh, which generates real secrets and your setup code.
# Keep the generated .env private. Never commit it or include it in a backup archive.
# Derived from the settings path, or selected with --project. Keep this value.
COMPOSE_PROJECT_NAME=GENERATED_BY_INIT
COMPOSE_FILE=compose.yaml
PASSDOWN_PROXY=caddy
PASSDOWN_DOMAIN=guides.example.org
BETTER_AUTH_URL=https://guides.example.org
# ACME contact email, or internal for a private certificate authority.
PASSDOWN_TLS=operator@example.org
PASSDOWN_HSTS_MAX_AGE=31536000
PASSDOWN_HTTP_PORT=80
PASSDOWN_HTTPS_PORT=443
GUIDE_DB_OWNER_PASSWORD=GENERATED_BY_INIT
GUIDE_DB_RUNTIME_PASSWORD=GENERATED_BY_INIT
BETTER_AUTH_SECRET=GENERATED_BY_INIT
PASSDOWN_SETUP_CODE_SHA256=GENERATED_HASH_ONLY_BY_INIT
# --build adds compose.build.yaml and the following local image references:
# PASSDOWN_IMAGE=passdown:local
# PASSDOWN_PROXY_IMAGE=passdown-caddy:local

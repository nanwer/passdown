# Passdown's bundled reverse proxy (Caddy). HTTPS on one port for whatever
# address the server is reached by, request-size limits, broad per-network
# circuit breakers, and no tokens in its logs.
#
# The certificate is made by Caddy's own local authority, never a public one:
# no ACME, no ports 80/443, no on-demand issuing. Caddy manages one
# certificate, for "localhost", and serves it for every name and IP address
# (fallback_sni and default_sni), so the site answers at any address with the
# usual first-visit browser warning, as Portainer does. Put a proxy with a
# trusted certificate in front for a public address.
#
# No Strict-Transport-Security header: browsers ignore it from a certificate
# they do not trust (RFC 6797, section 8.1), nothing here listens on plain
# HTTP for it to protect, and once someone trusts this authority it would pin
# every port of localhost. A proxy in front with a trusted certificate should
# send it (in Nginx Proxy Manager: HSTS Enabled).
{
	order rate_limit before basic_auth
	auto_https disable_redirects
	skip_install_trust
	default_sni localhost
	fallback_sni localhost
	# Requires preserved peer addresses for per-client isolation. See the
	# deployment guide before adding another proxy; never trust arbitrary XFF.
	log {
		output stderr
		format filter {
			wrap json
			request>uri regexp "(?i)^(?:[^/]|//).*$|^.*(?:/\.{1,2}/|//).*$|^(/(?:invite|reset|api/invitations|api/password-resets|api/admin|api/setup)(?:/|$|\?)).*$|^([^%?]*)%.*$|(\?).*$" "${1}${2}${3}[redacted]"
			request>headers delete
			resp_headers delete
		}
	}
}

# "localhost" names the one certificate; the bare address answers every host.
https://localhost, https:// {
	tls internal

	# By route, not by what a token looks like: a protected route keeps only its
	# prefix; a URI with a percent-escape is cut at the first %; any other query
	# string is replaced. Non-canonical paths and absolute targets are removed.
	log {
		output stderr
		format filter {
			wrap json
			request>uri regexp "(?i)^(?:[^/]|//).*$|^.*(?:/\.{1,2}/|//).*$|^(/(?:invite|reset|api/invitations|api/password-resets|api/admin|api/setup)(?:/|$|\?)).*$|^([^%?]*)%.*$|(\?).*$" "${1}${2}${3}[redacted]"
			request>headers delete
			resp_headers delete
		}
	}

	header {
		-Server
	}

	@upload path_regexp ^/api/studio/[a-z0-9][a-z0-9-]*/assets$
	@other not path_regexp ^/api/studio/[a-z0-9][a-z0-9-]*/assets$
	request_body @upload {
		max_size 22MiB
	}
	request_body @other {
		max_size 2MiB
	}

	# These count all requests, including successful sign-ins. Application
	# failure counters remain responsible for password guessing protection.
	rate_limit {
		zone sign_in {
			match {
				method POST
				path_regexp (?i)^/api/auth/sign-in/email$
			}
			key {client_ip}
			ipv6_prefix 64
			events {$PASSDOWN_SIGN_IN_LIMIT:300}
			window 1m
		}
		zone links {
			match {
				path_regexp (?i)^/(?:invite|reset|api/invitations|api/password-resets|api/setup|setup)(?:/|$)
			}
			key {client_ip}
			ipv6_prefix 64
			events {$PASSDOWN_LINK_LIMIT:300}
			window 1m
		}
		zone admin {
			match {
				path_regexp (?i)^/api/admin(?:/|$)
			}
			key {client_ip}
			ipv6_prefix 64
			events {$PASSDOWN_ADMIN_LIMIT:300}
			window 1m
		}
	}

	encode zstd gzip
	reverse_proxy web:3000
}

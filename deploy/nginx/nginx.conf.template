# Passdown reverse proxy (nginx), meeting the same contract as the default
# Caddy proxy: HTTPS for the configured domain, request-size limits, broad
# per-network circuit breakers and no tokens or setup codes in its logs.
# Rendered at start by passdown-nginx from the PASSDOWN_* settings.
include /etc/nginx/modules/*.conf;
worker_processes auto;
pid /run/nginx/nginx.pid;
# Request lines can carry tokens and nginx can't filter its error log, so only
# critical errors are written. Every request is logged once, redacted, below.
error_log stderr crit;
events {
  worker_connections 1024;
}
http {
  js_import passdown from /etc/nginx/passdown.js;
  js_set $passdown_uri passdown.redactedUri;
  js_set $passdown_client passdown.clientKey;
  server_tokens off;
  more_clear_headers Server;
  # No headers, cookies or query values: only the redacted request target.
  log_format passdown escape=json
    '{"time":"$time_iso8601","status":$status,"method":"$request_method",'
    '"uri":"$passdown_uri","bytes":$body_bytes_sent,"duration":$request_time,'
    '"client_ip":"$remote_addr"}';
  access_log /dev/stderr passdown;
  log_not_found off;

  client_max_body_size 2m;
  # Docker's resolver, so web can start after the proxy and move addresses.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # These count all requests, including successful sign-ins. Application
  # failure counters remain responsible for password guessing protection.
  limit_req_status 429;
  map $request_method $passdown_sign_in_key {
    POST $passdown_client;
    default '';
  }
  limit_req_zone $passdown_sign_in_key zone=sign_in:10m rate=@SIGN_IN_LIMIT@r/m;
  limit_req_zone $passdown_client zone=links:10m rate=@LINK_LIMIT@r/m;
  limit_req_zone $passdown_client zone=admin:10m rate=@ADMIN_LIMIT@r/m;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  server {
    listen 80;
    listen [::]:80;
    return 301 https://@DOMAIN@$request_uri;
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @DOMAIN@;
    ssl_certificate /etc/passdown/tls/fullchain.pem;
    ssl_certificate_key /etc/passdown/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=@HSTS_MAX_AGE@" always;

    # Only the observed peer is forwarded: a client's own X-Forwarded-For is
    # never trusted. See the proxy guide before putting another proxy in front.
    set $passdown_web http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection '';

    # Locations match the decoded, normalised path, case-insensitively where
    # a limit applies, so encoded or uppercase routes are limited too.
    location ~* ^/api/auth/sign-in/email$ {
      limit_req zone=sign_in burst=@SIGN_IN_BURST@ nodelay;
      proxy_pass $passdown_web;
    }
    location ~* ^/(?:invite|reset|api/invitations|api/password-resets|api/setup|setup)(?:/|$) {
      limit_req zone=links burst=@LINK_BURST@ nodelay;
      proxy_pass $passdown_web;
    }
    location ~* ^/api/admin(?:/|$) {
      limit_req zone=admin burst=@ADMIN_BURST@ nodelay;
      proxy_pass $passdown_web;
    }
    location ~ ^/api/studio/[a-z0-9][a-z0-9-]*/assets$ {
      client_max_body_size 22m;
      proxy_pass $passdown_web;
    }
    location / {
      proxy_pass $passdown_web;
    }
  }
}
